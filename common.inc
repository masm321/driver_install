CTL_CODE MACRO DeviceType:=<0>, Function:=<0>, Method:=<0>, Access:=<0>
    EXITM %(((DeviceType) SHL 16) OR ((Access) SHL 14) OR ((Function) SHL 2) OR (Method))
ENDM
FILE_DEVICE_UNKNOWN             equ 22h
FILE_ANY_ACCESS			equ 0
METHOD_BUFFERED                 equ 0
METHOD_IN_DIRECT                equ 1
METHOD_OUT_DIRECT               equ 2
METHOD_NEITHER                  equ 3

IOCTL_driver_exit         		equ CTL_CODE(FILE_DEVICE_UNKNOWN, 805h, METHOD_NEITHER , FILE_ANY_ACCESS)


IOCTL_vmm_event			equ CTL_CODE(FILE_DEVICE_UNKNOWN, 812h, METHOD_NEITHER , FILE_ANY_ACCESS)
IOCTL_mydriver_event_debugprogram	equ CTL_CODE(FILE_DEVICE_UNKNOWN, 813h, METHOD_NEITHER , FILE_ANY_ACCESS);要调试和程序名称发给驱动
IOCTL_vmm_start         		equ CTL_CODE(FILE_DEVICE_UNKNOWN, 806h, METHOD_NEITHER , FILE_ANY_ACCESS);加载虚拟机
IOCTL_vmm_exit			equ CTL_CODE(FILE_DEVICE_UNKNOWN, 810h, METHOD_NEITHER , FILE_ANY_ACCESS);退出虚拟机
IOCTL_vmm_fake_program		equ CTL_CODE(FILE_DEVICE_UNKNOWN, 811h, METHOD_NEITHER , FILE_ANY_ACCESS);要过滤的内存地址

IOCTL_vmm_fake_program_register	equ CTL_CODE(FILE_DEVICE_UNKNOWN, 814h, METHOD_NEITHER , FILE_ANY_ACCESS)
IOCTL_vmm_fix_program_address	equ CTL_CODE(FILE_DEVICE_UNKNOWN, 814h, METHOD_NEITHER , FILE_ANY_ACCESS);要调试和程序名称发给驱动

IOCTL_vmm_fix_program_		equ CTL_CODE(FILE_DEVICE_UNKNOWN, 815h, METHOD_NEITHER , FILE_ANY_ACCESS)
IOCTL_current_state			equ CTL_CODE(FILE_DEVICE_UNKNOWN, 816h, METHOD_NEITHER , FILE_ANY_ACCESS)；获取当前虚拟机状态
IOCTL_ext_program_write		equ CTL_CODE(FILE_DEVICE_UNKNOWN, 817h, METHOD_NEITHER , FILE_ANY_ACCESS)
IOCTL_vmm_record_attack_method	equ CTL_CODE(FILE_DEVICE_UNKNOWN, 818h, METHOD_NEITHER , FILE_ANY_ACCESS)；记录攻击的方法
IOCTL_vmm_SystemCodeIntegrity	equ CTL_CODE(FILE_DEVICE_UNKNOWN, 819h, METHOD_NEITHER , FILE_ANY_ACCESS)；测试模式检测

IFNDEF CTL_CODE
CTL_CODE MACRO DeviceType:=<0>, Function:=<0>, Method:=<0>, Access:=<0>
	EXITM %(((DeviceType) SHL 16) OR ((Access) SHL 14) OR ((Function) SHL 2) OR (Method))
ENDM
ENDIF
FILE_DEVICE_FILE_SYSTEM         equ 00000009
IOCTL_DISK_BASE                 equ FILE_DEVICE_DISK
IOCTL_DISK_GET_DRIVE_LAYOUT     equ CTL_CODE(IOCTL_DISK_BASE, 0003, METHOD_BUFFERED, FILE_READ_ACCESS)
FSCTL_GET_RETRIEVAL_POINTERS    equ CTL_CODE(FILE_DEVICE_FILE_SYSTEM, 28, METHOD_NEITHER, FILE_ANY_ACCESS) ; STARTING_VCN_INPUT_BUFFER, RETRIEVAL_POINTERS_BUFFER

